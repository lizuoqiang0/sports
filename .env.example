# 复制为 .env 后填写真实值
# cp .env.example .env && openssl rand -hex 32  # 分别填 SECRET_KEY / INTERNAL_API_TOKEN

ENVIRONMENT=production
# 支持 false/true，也兼容 release/debug
DEBUG=false
LOG_LEVEL=WARNING
SECRET_KEY=
WEAK_SECRET_BLOCK_IN_PROD=true
INTERNAL_API_TOKEN=
ALLOW_PUBLIC_REGISTER=false
EXPOSE_API_DOCS=false

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://ob_user:CHANGE_ME@postgres:5432/ob_sports
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
UVICORN_WORKERS=4

# 建议逗号分隔（Docker Compose 会剥掉 JSON 数组内的引号）
CORS_ORIGINS=https://your-domain.com
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,backend,ob-backend

BOOKMAKER_BROWSER_GATE_URL=http://host.docker.internal:9277
GATE_HOST=0.0.0.0
GATE_PORT=9277
BOOKMAKER_BROWSER_HEADLESS=1
DEFAULT_BET_MODE=manual
# 正式环境 100；测试可设 10
MIN_BET_AMOUNT=100
AI_SCAN_INTERVAL_SEC=30
AI_MAX_BETS_PER_CYCLE=3
OB_BET_VERIFY_INITIAL_DELAY_SEC=4
OB_BET_VERIFY_RETRIES=8
OB_BET_VERIFY_INTERVAL_SEC=2

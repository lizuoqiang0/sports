# 复制为 .env 后填写真实值
# cp .env.example .env && openssl rand -hex 32  # 分别填 SECRET_KEY / INTERNAL_API_TOKEN

LOG_LEVEL=INFO
# Docker 基础镜像默认使用 DaoCloud 国内镜像；可替换为企业私有仓库地址。
BASE_IMAGE_REGISTRY=docker.m.daocloud.io
SECRET_KEY=
INTERNAL_API_TOKEN=
ALLOW_PUBLIC_REGISTER=false

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://ob_user:CHANGE_ME@postgres:5432/ob_sports
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
UVICORN_WORKERS=4
UVICORN_LIMIT_CONCURRENCY=400

# 建议逗号分隔（Docker Compose 会剥掉 JSON 数组内的引号）
CORS_ORIGINS=https://your-domain.com
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,backend,ob-backend

BOOKMAKER_BROWSER_GATE_URL=http://host.docker.internal:9277
GATE_HOST=0.0.0.0
GATE_PORT=9277
BOOKMAKER_BROWSER_HEADLESS=1
DEFAULT_BET_MODE=manual
# 最低下注金额
MIN_BET_AMOUNT=100
AI_SCAN_INTERVAL_SEC=120

# === 投注规则 ===
MAX_BET_AMOUNT=100000
MAX_DAILY_BETS=50
DATA_RETENTION_HOURS=24

# === AI 自动投注 ===
AI_ENABLED=true
AI_ENABLE_OVER=true
AI_DEFAULT_STAKE=100
AI_STRATEGY_MAX_BET_AMOUNT=100
AI_STRATEGY_MAX_DAILY_BETS=10
AI_STOP_LOSS=500
AI_TAKE_PROFIT=1000
AI_MIN_BALANCE=10

# 下单失败重试（自动/手动共用 execute_bet）
BET_RETRY_COUNT=2
BET_RETRY_DELAY=3

# === AI 模型配置（唯一模型：DeepSeek）===
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek/deepseek-v4-pro-0813
# DEEPSEEK_TIMEOUT_SEC=90
# LLM_CLIENT_TIMEOUT_SEC=40
# LLM_MAX_TOKENS=1200
# PROMPT_MAX_CHARS=6000
# LLM_TEMPERATURE=0.2
# AI_ANALYZE_CONCURRENCY=2
